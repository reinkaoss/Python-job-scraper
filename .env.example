# Backend (Python)
PHANTOMJSCLOUD_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
APP_ENV=local

# Frontend (React)
# Leave empty for same-origin (production). Set to http://127.0.0.1:5000 for local dev if running Flask separately.
REACT_APP_API_BASE_URL=

# Domain baked into generated job-page URLs (File Extractor / Generate URL feature).
# Leave empty to use whatever domain the app is open on. Set to your deployed domain
# (e.g. https://job-scraper-xyz.vercel.app) if you want URLs generated during local
# dev to be reachable by the scraper that consumes them (it cannot reach localhost).
REACT_APP_PUBLIC_BASE_URL=
